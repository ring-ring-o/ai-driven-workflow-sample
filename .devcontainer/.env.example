# =============================================================================
# compose.yaml が読む設定。docker compose は同じディレクトリの .env を自動で読む。
# .env は init-host.sh が uid/gid をホストに合わせて書き換えるので、
# バージョン管理には .env.example のほうを置いている。
#
# 手で作る場合:  cp .env.example .env  してから id -u / id -g の値に直す。
#
# ★ ここに秘密情報（API キーなど）を書かないこと。
#   ワークスペースはコンテナ内の Claude Code から読める。
# =============================================================================

# コンテナ内ユーザーの uid/gid。ホスト（WSL）の `id -u` / `id -g` と一致させること。
# 一致していないと、コンテナが作ったファイルをホストから編集・削除できなくなる。
USER_UID=1000
USER_GID=1000
DEV_USER=vscode

# ワークスペースのマウント先。devcontainer.json の workspaceFolder と必ず揃えること。
WORKSPACE_FOLDER=/workspaces/ai-driven-workflow-sample
COMPOSE_PROJECT_NAME=ai-driven-workflow-sample

# ベースイメージのタグ（debian:<DEBIAN_TAG>）。
DEBIAN_TAG=trixie

# mise 本体の版。latest 以外を入れると mise ごと固定できる（例: v2026.9.8）。
MISE_VERSION=latest

TZ=Asia/Tokyo

# -----------------------------------------------------------------------------
# 外部通信遮断（既定: off）。詳細は docs/egress-firewall.md
# -----------------------------------------------------------------------------
# on にしてコンテナを「作り直す」と、起動時に許可リスト以外への通信を遮断し、
# 同時にコンテナ内ユーザーの sudo を取り上げる（内側から解除できないようにするため）。
# 解除するには off に戻してコンテナを作り直す。
EGRESS_FIREWALL=off

# 追加で許可するドメイン（カンマ区切り）。基本の許可リストは
# .devcontainer/firewall/allowlist.txt（こちらはイメージの再ビルドで反映）。
EGRESS_ALLOW_DOMAINS=
