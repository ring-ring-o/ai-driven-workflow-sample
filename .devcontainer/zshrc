# =============================================================================
# コンテナ内の zsh 設定。Dockerfile が /home/<user>/.zshrc として配置する。
# ホストの dotfiles は持ち込まない（誰が入っても同じ挙動にするため）。
# 個人の追加設定は ~/.zshrc.local に書く（イメージには含まれず、再作成で消える）。
# =============================================================================

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
# zsh-syntax-highlighting は最後に読むこと（他のプラグインのウィジェットを包むため）
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
fpath=("$ZSH/custom/plugins/zsh-completions/src" $fpath)

# oh-my-zsh の自動更新確認は止める（イメージを作り直せば更新される）
zstyle ':omz:update' mode disabled
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="yyyy-mm-dd"

source "$ZSH/oh-my-zsh.sh"

# --- 履歴 --------------------------------------------------------------------
# HISTFILE は Dockerfile の ENV で名前付きボリューム上を指している。
mkdir -p "$(dirname "${HISTFILE:-$HOME/.zsh_history}")"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS HIST_IGNORE_SPACE

# --- mise --------------------------------------------------------------------
# PATH にはシムが入っているので activate 無しでもツールは動く。
# activate すると [env]（node_modules/.bin など）が対話シェルにも効き、補完も使える。
eval "$(mise activate zsh)"
eval "$(mise completion zsh)" 2>/dev/null || true

# --- fzf ---------------------------------------------------------------------
# Ctrl-R で履歴検索、Ctrl-T でファイル選択、Alt-C でディレクトリ移動
source <(fzf --zsh) 2>/dev/null || true

# --- 環境 --------------------------------------------------------------------
export EDITOR="${EDITOR:-nano}"
export PAGER="${PAGER:-less}"
export LESS="-R"

# --- 外部通信遮断の表示 ------------------------------------------------------
# 遮断中はプロンプト右側に表示する（状態ファイルは root 所有で、ユーザーは偽装できない）。
if [[ -r /run/egress-firewall/applied-at ]]; then
  RPROMPT='%F{yellow}[egress: locked]%f'
fi

# --- エイリアス --------------------------------------------------------------
# タスクは Makefile ではなく mise が持っている。`mise tasks` で一覧。
alias t='mise run'
alias tasks='mise tasks'
alias ll='ls -alF'
alias la='ls -A'

# ワークスペースに居ないときは移動しておく（docker compose exec 直後など）
if [[ -n "${WORKSPACE_FOLDER:-}" && -d "${WORKSPACE_FOLDER}" ]] &&
   [[ "$PWD" == "/workspaces" || "$PWD" == "$HOME" ]]; then
  cd "${WORKSPACE_FOLDER}"
fi

[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
